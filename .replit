modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/konstruksi-ai: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pitch-deck-print-sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "url-fetch-security"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-access-revocation"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-revocation-tabs"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-build-race"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "zoomed-chat-controls"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-desktop"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-responsive"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tender-failure-endpoint"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tender-failure-browser"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/konstruksi-ai: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=18233 BASE_PATH=/ pnpm --filter @workspace/konstruksi-ai run dev"
waitForPort = 18233

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "pitch-deck-print-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-pitch-deck run check-print-sync"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "url-fetch-security"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:upload-security"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-access-revocation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:workspace-access-revocation"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-revocation-tabs"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-ai run test:workspace-revocation-tabs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-build-race"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run check:build-race"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "zoomed-chat-controls"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-ai run test:zoomed-chat-controls"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "web-desktop"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-ai run test:landing-hero"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "web-responsive"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-ai run test:landing-responsive"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tender-failure-endpoint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:tender-failure-guidance"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tender-failure-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/konstruksi-ai run test:tender-failure-guidance"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18233
externalPort = 3000

[userenv]

[userenv.shared]

[nix]
channel = "stable-25_05"
